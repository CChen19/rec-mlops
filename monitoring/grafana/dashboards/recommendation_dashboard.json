{
  "id": null,
  "uid": "rec-engine-v1",
  "title": "Recommendation Engine",
  "tags": ["recommendation", "ml", "performance"],
  "style": "dark",
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Response Time Percentiles",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(recommendation_api_response_time_seconds_bucket[2m])) * 1000",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, rate(recommendation_api_response_time_seconds_bucket[2m])) * 1000",
          "legendFormat": "p99"
        },
        {
          "expr": "histogram_quantile(0.50, rate(recommendation_api_response_time_seconds_bucket[2m])) * 1000",
          "legendFormat": "p50"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "lineWidth": 2 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 100 }
            ]
          }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "title": "Request Rate (RPS)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(recommendation_api_requests_total[2m])",
          "legendFormat": "{{endpoint}} {{method}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "lineWidth": 2 }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }
    },
    {
      "id": 3,
      "title": "In-flight Requests",
      "type": "stat",
      "datasource": "Prometheus",
      "targets": [
        { "expr": "recommendation_api_inflight_requests", "legendFormat": "In-flight" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 100 }
            ]
          }
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 8 }
    },
    {
      "id": 4,
      "title": "Cache Hit Rate",
      "type": "stat",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(recommendation_api_cache_hits_total[5m]) / (rate(recommendation_api_cache_hits_total[5m]) + rate(recommendation_api_cache_misses_total[5m]))",
          "legendFormat": "Hit Rate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "green", "value": 0.8 }
            ]
          }
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 8 }
    },
    {
      "id": 5,
      "title": "Models Loaded",
      "type": "stat",
      "datasource": "Prometheus",
      "targets": [
        { "expr": "recommendation_api_models_loaded", "legendFormat": "Models" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "green", "value": 2 }
            ]
          }
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 8 }
    },
    {
      "id": 6,
      "title": "Total Recommendations Served",
      "type": "stat",
      "datasource": "Prometheus",
      "targets": [
        { "expr": "sum(recommendation_api_recommendations_total)", "legendFormat": "Total" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 8 }
    },
    {
      "id": 7,
      "title": "Memory & CPU",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "process_resident_memory_bytes / 1024 / 1024",
          "legendFormat": "RSS Memory (MB)"
        },
        {
          "expr": "rate(process_cpu_seconds_total[2m]) * 100",
          "legendFormat": "CPU %"
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "lineWidth": 2 } }
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 }
    }
  ],
  "version": 1,
  "schemaVersion": 36
}
